# =============================================================================
# packages/config — Environment validation reference (NOT loaded at runtime)
# =============================================================================
#
# This package validates process.env from the HOST APP (web, admin, or api).
# You do NOT need a .env.local in this package for normal development.
# Set variables in each app's .env.local instead.
#
# Validators in src/env.ts:
#   getPublicSupabaseEnv()       → requires vars below (public schema)
#   getServiceRoleSupabaseEnv()  → requires public vars + service role key
# =============================================================================

# PUBLIC SCHEMA (required by all Supabase clients)
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# SERVICE-ROLE SCHEMA (required only when createAdminClient() is used)
# Supabase → Project Settings → API → service_role key (server-only, secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
