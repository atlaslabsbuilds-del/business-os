# =============================================================================
# packages/database — Supabase client reference (NOT loaded at runtime)
# =============================================================================
#
# This package reads process.env from the HOST APP at runtime.
# You do NOT need a .env.local in this package for normal development.
# Set variables in each app's .env.local instead.
#
# Optional: if you run Supabase CLI migrations from this directory, export
# these vars in your shell or use a local .env file for the CLI only.
# =============================================================================

# PUBLIC CLIENTS (browser, server, middleware) — validated by getPublicSupabaseEnv()
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ADMIN CLIENT (createAdminClient) — validated by getServiceRoleSupabaseEnv()
# Supabase → Project Settings → API → service_role key (server-only, secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
