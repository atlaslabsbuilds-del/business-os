# =============================================================================
# packages/ai — provider credentials (server-only)
# Copy relevant keys into each app's .env.local that uses @repo/ai.
# Prefer Netlify AI Gateway auto-injection in deployed environments.
# =============================================================================

# OpenAI (or Netlify gateway via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=

# Gmail OAuth (Google Cloud Console — Gmail API + OAuth 2.0 Web client)
# Authorized redirect URI (exact):
#   ${NEXT_PUBLIC_SITE_URL}/api/inbox/oauth/callback
# Local example:
#   http://localhost:3000/api/inbox/oauth/callback
# Do NOT use Supabase Auth callback for inbox Gmail connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=

# Optional verbose logs
AI_DEBUG=0
